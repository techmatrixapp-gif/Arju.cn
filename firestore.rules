rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper Functions ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return true;
    }

    // ---------- Admins Whitelist ----------
    match /admins/{uid} {
      allow read, write: if true;
    }

    // ---------- Menu Categories ----------
    // Supports both /categories and /menuCategories paths
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /menuCategories/{categoryId} {
      allow read, write: if true;
    }

    // ---------- Menu Items ----------
    match /menuItems/{itemId} {
      allow read, write: if true;
    }

    // ---------- General Site Content (hero, about, story, contact) ----------
    match /siteContent/{docId} {
      allow read, write: if true;
    }

    // ---------- General Settings (store hours, contact, payments) ----------
    match /settings/{docId} {
      allow read, write: if true;
    }

    // ---------- Blocked Slots (admin manually closes a date/time) ----------
    match /blockedSlots/{slotId} {
      allow read, write: if true;
    }

    // ---------- Bookings / Reservations ----------
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // ---------- Customer Orders ----------
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // ---------- Gallery Images ----------
    match /gallery/{imageId} {
      allow read, write: if true;
    }

    // ---------- Reviews & Testimonials ----------
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // ---------- Universal Fallback ----------
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

