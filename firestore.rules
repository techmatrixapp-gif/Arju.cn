rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper Functions ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- Admins Whitelist ----------
    // Only admins can read/write this collection.
    // You seed the first admin manually from the Firebase Console
    // (Firestore > admins > add doc with ID = your Auth UID).
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------- Menu Categories ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Menu Items ----------
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- General Site Content (hero, about, gallery, contact) ----------
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Blocked Slots (admin manually closes a date/time) ----------
    match /blockedSlots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Bookings ----------
    match /bookings/{bookingId} {
      // Public users can CREATE a booking request,
      // but only if it's submitted with status "pending"
      // and required fields are present (basic validation).
      allow create: if
        request.resource.data.status == 'pending' &&
        request.resource.data.customerName is string &&
        request.resource.data.phone is string &&
        request.resource.data.date is string &&
        request.resource.data.time is string &&
        request.resource.data.partySize is number;

      // Only admins can view the list, accept/decline/edit, or delete.
      allow read, update, delete: if isAdmin();
    }

    // ---------- Default Deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
